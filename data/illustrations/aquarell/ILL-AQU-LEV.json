  "evidence": [
    [
      {
        "s": "B",
        "ref": "LEV.1.9",
        "de": "Der Priester lässt alles auf dem Altar in Rauch aufgehen."
      },
      {
        "s": "B",
        "ref": "LEV.4.20",
        "de": "Der Priester erwirkt Sühne für sie, und es wird ihnen vergeben."
      },
      {
        "s": "B",
        "ref": "LEV.6.5",
        "de": "Beim Schuldopfer wird der Schaden ersetzt und ein Fünftel dazugegeben."
      },
      {
        "s": "B",
        "ref": "LEV.7.15",
        "de": "Das Fleisch des Dankopfers wird am selben Tag gegessen."
      },
      {
        "s": "I",
        "de": "Die Staffel im Sündopfer nach Rang (Priester, Gemeinde, Vorsteher, Einzelner; [[LEV.4.3-LEV.4.35]]) und die Weisungen für die Priester ([[LEV.6.8-LEV.7.38]]) sind nicht eigens dargestellt."
      }
    ],
    [
      {
        "s": "B",
        "ref": "LEV.16.21",
        "de": "Aaron legt beide Hände auf den Kopf des lebenden Bockes und bekennt über ihm alle Schuld der Israeliten."
      },
      {
        "s": "B",
        "ref": "LEV.16.21-LEV.16.22",
        "de": "Ein bereitstehender Mann schickt den Bock in die Wüste; er trägt ihre Schuld in ein ödes Land."
      },
      {
        "s": "B",
        "ref": "LEV.16.4",
        "de": "Der Hohepriester trägt an diesem Tag das heilige Leinengewand, Schärpe und Kopfbund aus Leinen."
      },
      {
        "s": "B",
        "ref": "LEV.16.29-LEV.16.31",
        "de": "Das Volk soll an diesem Tag fasten und ruhen."
      },
      {
        "s": "B",
        "ref": "LEV.16.34",
        "de": "Aaron tat, wie JHWH es Mose geboten hatte."
      },
      {
        "s": "I",
        "de": "Der andere Bock und der Stier, deren Blut ins Allerheiligste gebracht wird ([[LEV.16.11-LEV.16.15]]), sind weggelassen; das Volk im Hintergrund ist Ausgestaltung."
      }
    ],
    [
      {
        "s": "B",
        "ref": "LEV.19.2",
        "de": "Ihr sollt heilig sein, denn ich, JHWH, euer Gott, bin heilig."
      },
      {
        "s": "B",
        "ref": "LEV.19.18",
        "de": "Du sollst deinen Nächsten lieben wie dich selbst."
      },
      {
        "s": "B",
        "ref": "LEV.19.34",
        "de": "Den Fremden sollst du lieben wie dich selbst, denn ihr wart Fremde in Ägypten."
      },
      {
        "s": "I",
        "de": "Ob Kapitel 19 oder 16 die Mitte des Buches bildet, ist ein Vorschlag der Auslegung (Strukturkatalog)."
      }
    ],
    [
      {
        "s": "B",
        "ref": "LEV.23.2",
        "de": "Das sind die Festzeiten JHWHs, die ihr ausrufen sollt."
      },
      {
        "s": "B",
        "ref": "LEV.23.3",
        "de": "Sechs Tage soll man arbeiten, der siebte ist Sabbat."
      },
      {
        "s": "B",
        "ref": "LEV.23.40",
        "de": "Am Laubhüttenfest sollt ihr euch sieben Tage vor Gott freuen."
      },
      {
        "s": "B",
        "ref": "LEV.23.43",
        "de": "In Hütten wohnen, damit die Nachkommen wissen, dass Gott Israel aus Ägypten geführt hat."
      }
    ],
    [
      {
        "s": "B",
        "ref": "LEV.25.23",
        "de": "Das Land darf nicht für immer verkauft werden, denn das Land gehört mir; ihr seid Fremde und Gäste bei mir."
      },
      {
        "s": "B",
        "ref": "LEV.25.10",
        "de": "Das fünfzigste Jahr sollt ihr heiligen und Freiheit ausrufen im Land."
      },
      {
        "s": "B",
        "ref": "LEV.25.55",
        "de": "Mir gehören die Israeliten als Knechte, die ich aus Ägypten geführt habe."
      }
    ],
    [
      {
        "s": "B",
        "ref": "LEV.26.12",
        "de": "Ich will unter euch wandeln und euer Gott sein."
      },
      {
        "s": "B",
        "ref": "LEV.26.18",
        "de": "Hört ihr dann noch nicht, so strafe ich euch siebenfach weiter."
      },
      {
        "s": "B",
        "ref": "LEV.26.40",
        "de": "Dann werden sie ihre Schuld bekennen."
      },
      {
        "s": "B",
        "ref": "LEV.26.44",
        "de": "Auch im Land ihrer Feinde verwerfe ich sie nicht, um meinen Bund nicht zu brechen."
      }
    ]
  ],
