  "evidence": [
    [
      {
        "s": "B",
        "ref": "ACT.1.4-ACT.1.5",
        "de": "Jesus gebietet den Aposteln, in Jerusalem auf die Verheissung des Vaters zu warten: Sie werden mit heiligem Geist getauft werden."
      },
      {
        "s": "B",
        "ref": "ACT.1.8",
        "de": "Ihr werdet Kraft empfangen und meine Zeugen sein in Jerusalem, in ganz Judäa und Samarien und bis ans Ende der Erde."
      },
      {
        "s": "B",
        "ref": "ACT.1.9",
        "de": "Vor ihren Augen wird er emporgehoben, und eine Wolke nimmt ihn auf."
      }
    ],
    [
      {
        "s": "B",
        "ref": "ACT.2.5-ACT.2.11",
        "de": "In Jerusalem wohnen fromme Juden aus allen Völkern; jeder hört sie in seiner eigenen Sprache reden."
      },
      {
        "s": "B",
        "ref": "ACT.2.13",
        "de": "Andere spotten: Sie sind voll süssen Weins."
      },
      {
        "s": "B",
        "ref": "ACT.2.14",
        "de": "Petrus tritt mit den Elf auf, erhebt seine Stimme und redet zu ihnen."
      },
      {
        "s": "B",
        "ref": "ACT.2.41",
        "de": "Die sein Wort annehmen, lassen sich taufen, an diesem Tag etwa dreitausend."
      },
      {
        "s": "I",
        "de": "Das Brausen und die Zungen wie von Feuer ([[ACT.2.2-ACT.2.3]]) sind nicht gemalt (keine Licht- und Flammeneffekte); das Bild zeigt den Moment der Predigt. Ort vor einem Haus: Ausgestaltung, der Text nennt ihn nicht."
      }
    ],
    [
      {
        "s": "B",
        "ref": "ACT.8.5",
        "de": "Philippus geht hinab in eine Stadt Samariens und verkündigt ihnen den Christus."
      },
      {
        "s": "B",
        "ref": "ACT.8.26-ACT.8.28",
        "de": "Auf der Strasse von Jerusalem nach Gaza, die öde ist, sitzt ein Äthiopier, Kämmerer der Kandake, auf seinem Wagen und liest den Propheten Jesaja."
      },
      {
        "s": "B",
        "ref": "ACT.8.30",
        "de": "Philippus läuft hin, hört ihn lesen und fragt: Verstehst du, was du liest?"
      },
      {
        "s": "B",
        "ref": "ACT.8.38",
        "de": "Der Wagen hält, beide steigen ins Wasser, und Philippus tauft ihn."
      },
      {
        "s": "R",
        "de": "Wagenlenker, Pferd und Kleidung: plausible Ausgestaltung; der Text nennt nur den Wagen."
      }
    ],
    [
      {
        "s": "B",
        "ref": "ACT.10.1-ACT.10.2",
        "de": "Kornelius, Hauptmann in Cäsarea, fromm und gottesfürchtig mit seinem ganzen Haus."
      },
      {
        "s": "B",
        "ref": "ACT.10.24",
        "de": "Kornelius erwartet sie und hat seine Verwandten und engsten Freunde zusammengerufen."
      },
      {
        "s": "B",
        "ref": "ACT.10.25-ACT.10.26",
        "de": "Kornelius fällt Petrus zu Füssen; Petrus richtet ihn auf: Steh auf, auch ich bin ein Mensch."
      },
      {
        "s": "B",
        "ref": "ACT.10.34",
        "de": "Petrus: Gott sieht die Person nicht an."
      },
      {
        "s": "R",
        "de": "Raum, Kleidung und Zahl der Gäste: plausible Ausgestaltung; die Begleiter des Petrus aus Joppe ([[ACT.10.23]]) sind weggelassen."
      }
    ],
    [
      {
        "s": "B",
        "ref": "ACT.17.16",
        "de": "In Athen ergrimmt Paulus, weil er die Stadt voller Götterbilder sieht."
      },
      {
        "s": "B",
        "ref": "ACT.17.22",
        "de": "Paulus steht mitten auf dem Areopag und spricht: Männer von Athen."
      },
      {
        "s": "B",
        "ref": "ACT.17.32",
        "de": "Als sie von der Auferstehung der Toten hören, spotten die einen, die anderen wollen ihn darüber noch einmal hören."
      },
      {
        "s": "B",
        "ref": "ACT.17.34",
        "de": "Einige schliessen sich ihm an und glauben, darunter Dionysius, ein Mitglied des Areopags, und eine Frau namens Damaris."
      },
      {
        "s": "R",
        "de": "Tempel im Hintergrund, Kleidung, Zahl der Zuhörer: plausible Ausgestaltung."
      }
    ],
    [
      {
        "s": "B",
        "ref": "ACT.28.16",
        "de": "In Rom darf Paulus für sich wohnen, mit dem Soldaten, der ihn bewacht."
      },
      {
        "s": "B",
        "ref": "ACT.28.20",
        "de": "Wegen der Hoffnung Israels trage ich diese Kette."
      },
      {
        "s": "B",
        "ref": "ACT.28.30-ACT.28.31",
        "de": "Zwei ganze Jahre bleibt er in seiner eigenen Mietwohnung, empfängt alle, die zu ihm kommen, verkündigt das Reich Gottes und lehrt über den Herrn Jesus Christus mit allem Freimut, ungehindert."
      },
      {
