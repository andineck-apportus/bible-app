  "evidence": [
    [
      {
        "s": "B",
        "ref": "JER.1.6",
        "de": "Jeremia: Ich kann nicht reden, ich bin zu jung."
      },
      {
        "s": "B",
        "ref": "JER.1.10",
        "de": "Ich setze dich über Völker und Königreiche, auszureissen und niederzureissen, zu verderben und zu zerstören, zu bauen und zu pflanzen."
      },
      {
        "s": "I",
        "de": "Die Verben kehren im Buch wieder ([[JER.18.7-JER.18.9]], [[JER.31.28]]); die Zuordnung zu Gericht und Neuanfang ist Bildgestaltung."
      }
    ],
    [
      {
        "s": "B",
        "ref": "JER.18.3",
        "de": "Der Töpfer arbeitet auf der Scheibe (wörtlich: auf den zwei Steinen)."
      },
      {
        "s": "B",
        "ref": "JER.18.4",
        "de": "Das Gefäss missrät ihm in der Hand, und er macht daraus ein anderes Gefäss."
      },
      {
        "s": "B",
        "ref": "JER.18.6",
        "de": "Wie der Ton in der Hand des Töpfers, so seid ihr in meiner Hand, Haus Israel."
      },
      {
        "s": "R",
        "de": "Werkstatt, Kleidung und Fussantrieb der Scheibe: plausible Ausgestaltung."
      },
      {
        "s": "I",
        "de": "Die Deutung mit zwei mal zwei Fällen ([[JER.18.7-JER.18.10]]) und die Antwort des Volkes ([[JER.18.12]]) stehen nicht im Bild."
      }
    ],
    [
      {
        "s": "B",
        "ref": "JER.31.31-JER.31.32",
        "de": "Ich schliesse einen neuen Bund, nicht wie den Bund mit ihren Vätern, den sie gebrochen haben."
      },
      {
        "s": "B",
        "ref": "JER.31.33",
        "de": "Ich lege meine Weisung in ihr Inneres und schreibe sie auf ihr Herz."
      },
      {
        "s": "B",
        "ref": "JER.31.34",
        "de": "Sie werden mich alle kennen; ich vergebe ihre Schuld und gedenke ihrer Sünde nicht mehr."
      }
    ],
    [
      {
        "s": "B",
        "ref": "JER.32.2",
        "de": "Das Heer Babels belagert Jerusalem; Jeremia ist im Wachhof eingeschlossen."
      },
      {
        "s": "B",
        "ref": "JER.32.9-JER.32.10",
        "de": "Jeremia kauft den Acker, wiegt siebzehn Schekel Silber auf der Waage ab und lässt Zeugen unterschreiben."
      },
      {
        "s": "B",
        "ref": "JER.32.12-JER.32.14",
        "de": "Er gibt den versiegelten und den offenen Kaufbrief Baruch vor den Zeugen; sie sollen in ein Tongefäss gelegt werden."
      },
      {
        "s": "B",
        "ref": "JER.32.15",
        "de": "Man wird in diesem Land wieder Häuser, Felder und Weinberge kaufen."
      },
      {
        "s": "R",
        "de": "Tisch, Geldbeutel, Kleidung und Zahl der Zeugen: plausible Ausgestaltung."
      },
      {
        "s": "I",
        "de": "Wiegen, Übergabe und Aufbewahrung sind in einem Bild zusammengezogen."
      }
    ],
    [
      {
        "s": "B",
        "ref": "JER.36.22",
        "de": "Der König sitzt im Winterhaus im neunten Monat, vor ihm brennt das Kohlenbecken."
      },
      {
        "s": "B",
        "ref": "JER.36.23",
        "de": "Nach drei oder vier Spalten schneidet er sie mit dem Schreibermesser ab und wirft sie ins Feuer."
      },
      {
        "s": "B",
        "ref": "JER.36.25",
        "de": "Elnatan, Delaja und Gemarja bitten den König, die Rolle nicht zu verbrennen."
      },
      {
        "s": "B",
        "ref": "JER.36.32",
        "de": "Jeremia nimmt eine andere Rolle, und Baruch schreibt alle Worte darauf, und es kommen noch viele hinzu."
      },
      {
        "s": "R",
        "de": "Raum, Stuhl und Kleidung: plausible Ausgestaltung; einer der drei Beamten steht für alle."
      },
      {
        "s": "I",
        "de": "Jeremia und Baruch fehlen im Bild, weil sie verborgen sind ([[JER.36.26]]); die neue Rolle ist nicht gemalt."
      }
    ],
    [
      {
        "s": "B",
        "ref": "JER.46.26",
        "de": "Danach wird Ägypten wieder bewohnt sein wie in früheren Tagen."
      },
      {
        "s": "B",
        "ref": "JER.48.47",
        "de": "Ich wende das Geschick Moabs am Ende der Tage."
      },
      {
        "s": "B",
        "ref": "JER.50.4",
        "de": "Die Israeliten und die Judäer kommen zusammen und suchen den HERRN."
      },
      {
        "s": "B",
        "ref": "JER.52.31-JER.52.34",
        "de": "Ewil-Merodach erhebt Jojachin; er isst sein Leben lang am Tisch des Königs."
      },
      {
        "s": "I",
        "de": "Die Wende des Geschicks gilt auch Ammon und Elam ([[JER.49.6]], [[JER.49.39]]); in der griechischen Fassung stehen die Völkersprüche an anderer Stelle (nach [[JER.25.13]])."
      }
    ]
  ],
