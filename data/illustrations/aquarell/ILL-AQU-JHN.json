  "evidence": [
    [
      {
        "s": "B",
        "ref": "JHN.1.1",
        "de": "Im Anfang war das Wort, und das Wort war bei Gott, und das Wort war Gott."
      },
      {
        "s": "B",
        "ref": "JHN.1.11-JHN.1.12",
        "de": "Er kam in das Seine, und die Seinen nahmen ihn nicht auf; denen, die ihn aufnahmen, gab er Vollmacht, Kinder Gottes zu werden."
      },
      {
        "s": "B",
        "ref": "JHN.1.14",
        "de": "Das Wort wurde Fleisch und wohnte unter uns."
      },
      {
        "s": "B",
        "ref": "JHN.1.18",
        "de": "Niemand hat Gott je gesehen; der einzige Sohn, der an der Brust des Vaters ist, hat ihn kundgemacht."
      },
      {
        "s": "I",
        "de": "Die Anordnung in zwei Ebenen ist Bildgestaltung; Licht und Finsternis ([[JHN.1.4-JHN.1.5]]) und das Zeugnis des Johannes ([[JHN.1.6-JHN.1.8]], [[JHN.1.15]]) sind weggelassen."
      }
    ],
    [
      {
        "s": "B",
        "ref": "JHN.11.25",
        "de": "Ich bin die Auferstehung und das Leben."
      },
      {
        "s": "B",
        "ref": "JHN.11.38-JHN.11.41",
        "de": "Das Grab ist eine Höhle, ein Stein liegt davor; sie nehmen den Stein weg."
      },
      {
        "s": "B",
        "ref": "JHN.11.43-JHN.11.44",
        "de": "Jesus ruft mit lauter Stimme: Lazarus, komm heraus! Der Tote kommt heraus, an Füssen und Händen mit Binden umwickelt, das Gesicht mit einem Schweisstuch umbunden."
      },
      {
        "s": "R",
        "de": "Marta und Maria am Grab: plausible Ausgestaltung (sie sind in [[JHN.11.39]] und [[JHN.11.32]] dabei); Zahl der Leute aus Jerusalem ([[JHN.11.42]], [[JHN.11.45]]) offen."
      },
      {
        "s": "I",
        "de": "Gebärden des Staunens: Bildgestaltung; der Text erzählt keine Reaktion der Schwestern."
      }
    ],
    [
      {
        "s": "B",
        "ref": "JHN.19.29",
        "de": "Dort steht ein Gefäss voll Essig; sie stecken einen Schwamm voll Essig auf einen Ysop und halten ihn an seinen Mund."
      },
      {
        "s": "B",
        "ref": "JHN.19.30",
        "de": "Er sagt: Es ist vollbracht, neigt das Haupt und übergibt den Geist."
      },
      {
        "s": "R",
        "de": "Weggelassen: die Soldaten, die Mitgekreuzigten ([[JHN.19.18]]), die Frauen und der Jünger beim Kreuz ([[JHN.19.25-JHN.19.27]]) und die Tafel ([[JHN.19.19]])."
      },
      {
        "s": "I",
        "de": "Friedliches Gesicht: Bildgestaltung für «vollbracht»."
      }
    ],
    [
      {
        "s": "B",
        "ref": "JHN.20.26",
        "de": "Acht Tage später sind die Jünger wieder drinnen, Thomas bei ihnen; Jesus kommt, obwohl die Türen verschlossen sind, und tritt in die Mitte."
      },
      {
        "s": "B",
        "ref": "JHN.20.27",
        "de": "Er sagt zu Thomas: Reiche deinen Finger her und sieh meine Hände."
      },
      {
        "s": "B",
        "ref": "JHN.20.28",
        "de": "Thomas antwortet: Mein Herr und mein Gott!"
      },
      {
        "s": "B",
        "ref": "JHN.20.31",
        "de": "Aufgeschrieben, damit ihr glaubt, dass Jesus der Christus ist, der Sohn Gottes."
      },
      {
        "s": "I",
        "de": "Thomas kniet und berührt nicht: Der Text sagt nicht, dass er die Wunden berührt; das Knien ist Bildgestaltung."
      }
    ]
  ],
