  "evidence": [
    [
      {
        "s": "B",
        "ref": "HOS.1.3",
        "de": "Er ging und nahm Gomer, die Tochter Diblajims."
      },
      {
        "s": "B",
        "ref": "HOS.1.2",
        "de": "Geh, nimm dir eine Frau der Hurerei, denn das Land ist von JHWH abgefallen."
      },
      {
        "s": "R",
        "de": "Hand in Hand vor dem Haus ihres Vaters als Bild für «nahm sie»; wie die Heirat geschah, sagt der Text nicht."
      },
      {
        "s": "I",
        "de": "Zurückhaltend gemalt: «Frau der Hurerei» wird nicht ausgemalt; ernstes Gesicht Hoseas als Hinweis auf den Auftrag als Zeichen."
      }
    ],
    [
      {
        "s": "B",
        "ref": "HOS.1.4",
        "de": "Nenne ihn Jesreel."
      },
      {
        "s": "B",
        "ref": "HOS.1.6",
        "de": "Nenne sie Lo-Ruhama, denn ich erbarme mich nicht mehr."
      },
      {
        "s": "B",
        "ref": "HOS.1.9",
        "de": "Nenne ihn Lo-Ammi, denn ihr seid nicht mein Volk."
      },
      {
        "s": "B",
        "ref": "HOS.2.23",
        "de": "Ich erbarme mich der Lo-Ruhama und sage zu Lo-Ammi: Du bist mein Volk."
      },
      {
        "s": "B",
        "ref": "HOS.3.4-HOS.3.5",
        "de": "Viele Tage ohne König und Opfer; danach kehren sie um und suchen JHWH."
      }
    ],
    [
      {
        "s": "B",
        "ref": "HOS.6.1",
        "de": "Kommt, wir wollen umkehren zu JHWH."
      },
      {
        "s": "B",
        "ref": "HOS.6.4",
        "de": "Eure Güte ist wie eine Morgenwolke, wie Tau, der früh vergeht."
      },
      {
        "s": "B",
        "ref": "HOS.6.6",
        "de": "Denn an Güte habe ich Gefallen, nicht am Schlachtopfer, an Gotteserkenntnis mehr als an Brandopfern."
      }
    ],
    [
      {
        "s": "B",
        "ref": "HOS.11.1",
        "de": "Als Israel jung war, gewann ich es lieb, und aus Ägypten rief ich meinen Sohn."
      },
      {
        "s": "B",
        "ref": "HOS.11.8",
        "de": "Wie könnte ich dich preisgeben, Efraim? Mein Herz wendet sich in mir."
      },
      {
        "s": "B",
        "ref": "HOS.11.9",
        "de": "Ich will meinen glühenden Zorn nicht vollstrecken, denn Gott bin ich und nicht ein Mensch."
      },
      {
        "s": "B",
        "ref": "HOS.11.11",
        "de": "Ich lasse sie wohnen in ihren Häusern."
      }
    ],
    [
      {
        "s": "B",
        "ref": "HOS.14.1",
        "de": "Kehre um, Israel, zu JHWH, deinem Gott."
      },
      {
        "s": "B",
        "ref": "HOS.14.4",
        "de": "Ich will ihre Abtrünnigkeit heilen, sie aus freien Stücken lieben."
      },
      {
        "s": "B",
        "ref": "HOS.14.5",
        "de": "Ich werde für Israel wie der Tau sein; es soll blühen wie die Lilie."
      },
      {
        "s": "B",
        "ref": "HOS.14.9",
        "de": "Wer ist weise, dass er dies versteht?"
      }
    ]
