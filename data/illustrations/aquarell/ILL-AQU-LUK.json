  "evidence": [
    [
      {
        "s": "B",
        "ref": "LUK.2.7",
        "de": "Sie wickelt ihren erstgeborenen Sohn und legt ihn in eine Futterkrippe, weil in der Unterkunft kein Platz für sie war."
      },
      {
        "s": "B",
        "ref": "LUK.2.8-LUK.2.9",
        "de": "Hirten halten in der Nacht Wache über ihre Herde; ein Engel des Herrn tritt zu ihnen, und sie fürchten sich sehr."
      },
      {
        "s": "B",
        "ref": "LUK.2.11",
        "de": "Heute ist euch in der Stadt Davids ein Retter geboren."
      },
      {
        "s": "R",
        "de": "Unterstand und Steintrog, Zahl der Hirten: plausible Ausgestaltung; der Text nennt weder Stall noch Tiere bei der Krippe. Josef ([[LUK.2.4-LUK.2.5]]) ist weggelassen."
      },
      {
        "s": "I",
        "de": "Zwei Orte in einem Bild (vorn die Krippe, hinten das Feld) und der Engel ohne Flügel und ohne Lichtglanz ([[LUK.2.9]]): Bildgestaltung."
      }
    ],
    [
      {
        "s": "B",
        "ref": "LUK.4.16-LUK.4.17",
        "de": "Am Sabbat geht er in Nazaret in die Synagoge, steht auf zum Lesen, und man reicht ihm die Rolle des Propheten Jesaja."
      },
      {
        "s": "B",
        "ref": "LUK.4.20",
        "de": "Er rollt die Rolle zusammen, gibt sie dem Diener, setzt sich; die Augen aller sind auf ihn gerichtet."
      },
      {
        "s": "B",
        "ref": "LUK.4.21",
        "de": "Heute hat sich dieses Schriftwort erfüllt."
      },
      {
        "s": "R",
        "de": "Raum, Bänke, Zahl der Zuhörer: plausible Ausgestaltung."
      },
      {
        "s": "I",
        "de": "Die spätere Ablehnung und der Zorn der Leute ([[LUK.4.28-LUK.4.29]]) gehören nicht zu diesem Moment und sind nicht gezeigt."
      }
    ],
    [
      {
        "s": "B",
        "ref": "LUK.9.51",
        "de": "Als sich die Tage erfüllten, fasst er den festen Entschluss, nach Jerusalem zu gehen."
      },
      {
        "s": "B",
        "ref": "LUK.13.22",
        "de": "Er zieht durch Städte und Dörfer, lehrt und nimmt seinen Weg nach Jerusalem."
      },
      {
        "s": "B",
        "ref": "LUK.17.11",
        "de": "Auf dem Weg nach Jerusalem zieht er mitten durch Samarien und Galiläa."
      },
      {
        "s": "B",
        "ref": "LUK.18.31",
        "de": "Er nimmt die Zwölf zu sich: Wir gehen hinauf nach Jerusalem."
      },
      {
        "s": "B",
        "ref": "LUK.19.1-LUK.19.10",
        "de": "In Jericho kehrt er bei Zachäus ein: Der Menschensohn ist gekommen, zu suchen und zu retten, was verloren ist."
      },
      {
        "s": "B",
        "ref": "LUK.19.28",
        "de": "Er geht voran und zieht hinauf nach Jerusalem."
      }
    ],
    [
      {
        "s": "B",
        "ref": "LUK.23.46",
        "de": "Jesus ruft laut: Vater, in deine Hände übergebe ich meinen Geist."
      },
      {
        "s": "B",
        "ref": "LUK.23.53",
        "de": "Josef von Arimatäa legt ihn in ein in den Felsen gehauenes Grab."
      },
      {
        "s": "B",
        "ref": "LUK.24.3",
        "de": "Die Frauen finden den Leib des Herrn Jesus nicht."
      },
      {
        "s": "B",
        "ref": "LUK.24.30-LUK.24.31",
        "de": "In Emmaus bricht er das Brot; da gehen ihnen die Augen auf, und sie erkennen ihn."
      },
      {
        "s": "B",
        "ref": "LUK.24.48",
        "de": "Ihr seid Zeugen dafür."
      },
      {
        "s": "B",
        "ref": "LUK.24.50-LUK.24.53",
        "de": "Er segnet sie und scheidet von ihnen; sie sind allezeit im Tempel und preisen Gott."
      },
      {
        "s": "I",
        "de": "Das Bekenntnis des Hauptmanns ([[LUK.23.47]]) und die Worte über das Hinaufgetragenwerden ([[LUK.24.51]], textkritisch unsicher) stehen in den Kapitelbildern."
      }
