  "evidence": [
    [
      {
        "s": "B",
        "ref": "1KI.3.27",
        "de": "Der König sagt: Gebt ihr das lebende Kind und tötet es nicht; sie ist seine Mutter."
      },
      {
        "s": "B",
        "ref": "1KI.3.24-1KI.3.26",
        "de": "Ein Schwert wird gebracht; die Mutter des lebenden Kindes wird von Erbarmen ergriffen."
      },
      {
        "s": "B",
        "ref": "1KI.3.9",
        "de": "Salomo bittet um ein hörendes Herz, um das Volk zu richten."
      },
      {
        "s": "B",
        "ref": "1KI.3.28",
        "de": "Ganz Israel sieht, dass die Weisheit Gottes in ihm ist."
      },
      {
        "s": "R",
        "de": "Wache, Kleidung, Saal: plausible Ausgestaltung; Salomos Alter ist Bildgestaltung."
      },
      {
        "s": "I",
        "de": "Der Traum in Gibeon ([[1KI.3.5-1KI.3.15]]) ist nicht gemalt, weil Gott darin spricht."
      }
    ],
    [
      {
        "s": "B",
        "ref": "1KI.6.1",
        "de": "Im vierhundertachtzigsten Jahr nach dem Auszug beginnt Salomo den Bau."
      },
      {
        "s": "B",
        "ref": "1KI.6.2",
        "de": "Das Haus ist sechzig Ellen lang, zwanzig breit und dreissig hoch."
      },
      {
        "s": "B",
        "ref": "1KI.6.19-1KI.6.20",
        "de": "Der innerste Raum für die Lade, zwanzig Ellen lang, breit und hoch."
      },
      {
        "s": "B",
        "ref": "1KI.6.38",
        "de": "In sieben Jahren wird das Haus vollendet."
      },
      {
        "s": "I",
        "de": "Salomos Palast ([[1KI.7.1-1KI.7.12]]) und die Geräte ([[1KI.7.13-1KI.7.51]]) sind nicht eingetragen."
      }
    ],
    [
      {
        "s": "B",
        "ref": "1KI.8.30",
        "de": "Höre im Himmel, und wenn du hörst, vergib."
      },
      {
        "s": "B",
        "ref": "1KI.8.41-1KI.8.43",
        "de": "Auch den Fremden, der aus fernem Land kommt, soll JHWH hören."
      },
      {
        "s": "B",
        "ref": "1KI.8.46-1KI.8.50",
        "de": "Wenn sie gefangen weggeführt werden und umkehren, so höre und vergib."
      },
      {
        "s": "I",
        "de": "Dass die letzte Bitte auf das Exil am Ende von [[2KI.25]] vorausweist, ist Lesart."
      }
    ],
    [
      {
        "s": "B",
        "ref": "1KI.11.29",
        "de": "Ahija trägt einen neuen Mantel; die beiden sind allein auf dem Feld."
      },
      {
        "s": "B",
        "ref": "1KI.11.30-1KI.11.31",
        "de": "Ahija zerreisst den neuen Mantel in zwölf Stücke und sagt zu Jerobeam: Nimm dir zehn Stücke."
      },
      {
        "s": "B",
        "ref": "1KI.11.4",
        "de": "Seine Frauen wenden Salomos Herz anderen Göttern zu."
      },
      {
        "s": "B",
        "ref": "1KI.12.20",
        "de": "Ganz Israel macht Jerobeam zum König."
      },
      {
        "s": "R",
        "de": "Kleidung, Ledertasche (Aufseher, [[1KI.11.28]]), Landschaft: plausible Ausgestaltung."
      },
      {
        "s": "I",
        "de": "Wessen Mantel zerrissen wird, sagt der Text nicht ganz eindeutig; gemalt ist der Mantel Ahijas, wie die meisten lesen."
      }
    ],
    [
      {
        "s": "B",
        "ref": "1KI.18.31-1KI.18.32",
        "de": "Elija nimmt zwölf Steine, baut einen Altar und macht einen Graben darum."
      },
      {
        "s": "B",
        "ref": "1KI.18.33-1KI.18.35",
        "de": "Vier Krüge Wasser werden dreimal über das Opfer und das Holz gegossen; auch der Graben füllt sich."
      },
      {
        "s": "B",
        "ref": "1KI.18.26-1KI.18.29",
        "de": "Die Propheten Baals rufen vom Morgen bis zum Abend, aber keine Antwort kommt."
      },
      {
        "s": "B",
        "ref": "1KI.18.39",
        "de": "Das Volk fällt auf das Angesicht und ruft: JHWH ist Gott."
      },
      {
        "s": "R",
        "de": "Zwei Wasserträger statt aller, Kleidung der Baalspropheten: plausible Ausgestaltung."
      },
      {
        "s": "I",
        "de": "Das Feuer ([[1KI.18.38]]), das Ritzen der Baalspropheten ([[1KI.18.28]]) und ihre Tötung ([[1KI.18.40]]) sind nicht gemalt."
      }
    ],
    [
      {
        "s": "B",
        "ref": "1KI.19.11-1KI.19.12",
        "de": "JHWH ist nicht im Sturm, nicht im Erdbeben, nicht im Feuer; nach dem Feuer eine leise Stille."
      },
      {
        "s": "B",
        "ref": "1KI.19.13",
        "de": "Elija hört es und verhüllt sein Gesicht mit seinem Mantel."
      },
      {
        "s": "B",
        "ref": "1KI.22.37-1KI.22.38",
        "de": "Ahab stirbt, wie das Wort JHWHs es gesagt hat."
      },
      {
        "s": "I",
        "de": "Die Wiedergabe des vierten Glieds ist frei; der Ausdruck ist schwer zu übersetzen (etwa: Stimme einer leisen Stille)."
      }
    ]
