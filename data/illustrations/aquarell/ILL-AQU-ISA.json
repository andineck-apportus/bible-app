  "evidence": [
    [
      {
        "s": "B",
        "ref": "ISA.1.2",
        "de": "Himmel und Erde sollen hören: Kinder habe ich grossgezogen, sie aber sind von mir abgefallen."
      },
      {
        "s": "B",
        "ref": "ISA.1.18",
        "de": "Kommt, lasst uns rechten: Wären eure Sünden wie Scharlach, sollen sie weiss werden wie Schnee."
      },
      {
        "s": "B",
        "ref": "ISA.1.19-ISA.1.20",
        "de": "Wenn ihr willig seid, esst ihr das Gute des Landes; wenn ihr euch weigert, frisst euch das Schwert."
      }
    ],
    [
      {
        "s": "B",
        "ref": "ISA.6.1",
        "de": "Im Todesjahr des Königs Usija, im Tempel."
      },
      {
        "s": "B",
        "ref": "ISA.6.4",
        "de": "Die Schwellen beben, und das Haus füllt sich mit Rauch."
      },
      {
        "s": "B",
        "ref": "ISA.6.8",
        "de": "Jesaja antwortet: Hier bin ich, sende mich."
      },
      {
        "s": "R",
        "de": "Alter, Kleidung und Haltung Jesajas: plausible Ausgestaltung."
      },
      {
        "s": "I",
        "de": "Gott, Thron, Gewandsaum und Serafim ([[ISA.6.1-ISA.6.2]]) werden nicht gemalt; der leere Raum über Jesaja steht für den, der fragt. Die Reinigung mit der Kohle ([[ISA.6.6-ISA.6.7]]) und der harte Auftrag ([[ISA.6.9-ISA.6.13]]) sind weggelassen."
      }
    ],
    [
      {
        "s": "B",
        "ref": "ISA.37.14",
        "de": "Hiskija nimmt den Brief, geht hinauf in das Haus des HERRN und breitet ihn vor dem HERRN aus."
      },
      {
        "s": "B",
        "ref": "ISA.37.15-ISA.37.20",
        "de": "Hiskija betet: Rette uns, damit alle Königreiche der Erde erkennen, dass du allein HERR bist."
      },
      {
        "s": "R",
        "de": "Knien, erhobene Hände und die Steine auf dem Brief: plausible Ausgestaltung."
      },
      {
        "s": "I",
        "de": "Die Antwort durch Jesaja ([[ISA.37.21-ISA.37.35]]) und die Rettung ([[ISA.37.36-ISA.37.38]]) sind nicht gemalt."
      }
    ],
    [
      {
        "s": "B",
        "ref": "ISA.40.1-ISA.40.2",
        "de": "Tröstet, tröstet mein Volk; ihre Schuld ist abgetragen."
      },
      {
        "s": "B",
        "ref": "ISA.40.8",
        "de": "Das Gras verdorrt, die Blume welkt, aber das Wort unseres Gottes bleibt in Ewigkeit."
      },
      {
        "s": "B",
        "ref": "ISA.40.11",
        "de": "Wie ein Hirte weidet er seine Herde und trägt die Lämmer."
      }
    ],
    [
      {
        "s": "B",
        "ref": "ISA.52.13",
        "de": "Siehe, mein Knecht wird Erfolg haben, er wird erhöht sein."
      },
      {
        "s": "B",
        "ref": "ISA.53.5",
        "de": "Er wurde durchbohrt um unserer Vergehen willen; durch seine Wunden sind wir geheilt."
      },
      {
        "s": "B",
        "ref": "ISA.53.11-ISA.53.12",
        "de": "Mein Knecht macht die Vielen gerecht; er trug die Sünde der Vielen."
      },
      {
        "s": "I",
        "de": "Wer der Knecht ist, sagt der Text nicht; Deutungen (auf Israel, den Propheten, in [[ACT.8.32-ACT.8.35]] auf Jesus) gehören nicht ins Bild."
      },
      {
        "s": "I",
        "de": "A/A′ (Gott spricht) steht im Text; B/B′ und die Mitte als Achse sind eine Deutung der Gliederung in fünf Strophen."
      }
    ],
    [
      {
        "s": "B",
        "ref": "ISA.65.13",
        "de": "Meine Knechte werden essen, ihr aber werdet hungern."
      },
      {
        "s": "B",
        "ref": "ISA.65.17",
        "de": "Ich schaffe einen neuen Himmel und eine neue Erde."
      },
      {
        "s": "B",
        "ref": "ISA.66.23-ISA.66.24",
        "de": "Alles Fleisch kommt, um anzubeten; und sie sehen die Leichen derer, die von mir abgefallen sind."
