  "evidence": [
    [
      {
        "s": "B",
        "ref": "MAT.1.18",
        "de": "Maria ist vom heiligen Geist schwanger."
      },
      {
        "s": "B",
        "ref": "MAT.1.23",
        "de": "Immanuel, das heisst übersetzt: Gott mit uns."
      },
      {
        "s": "B",
        "ref": "MAT.1.24-MAT.1.25",
        "de": "Josef nimmt Maria zu sich; sie bringt einen Sohn zur Welt, und er gibt ihm den Namen Jesus."
      },
      {
        "s": "R",
        "de": "Einfaches Haus statt Stall: Matthäus nennt keinen Ort der Geburt ausser Betlehem ([[MAT.2.1]]) und keine Krippe."
      },
      {
        "s": "I",
        "de": "Josef hält das Kind beim Namengeben im Arm: Bildgestaltung; der Text sagt nur, dass er ihm den Namen gibt."
      }
    ],
    [
      {
        "s": "B",
        "ref": "MAT.5.1-MAT.5.2",
        "de": "Jesus steigt auf den Berg, setzt sich, die Jünger treten zu ihm, und er lehrt sie."
      },
      {
        "s": "B",
        "ref": "MAT.5.3-MAT.5.10",
        "de": "Acht Seligpreisungen; die erste und die achte mit derselben Verheissung: ihnen gehört das Reich der Himmel."
      },
      {
        "s": "B",
        "ref": "MAT.7.28-MAT.7.29",
        "de": "Die Mengen staunen, denn er lehrt wie einer, der Vollmacht hat."
      },
      {
        "s": "I",
        "de": "Die neunte Seligpreisung in der Anrede «ihr» ([[MAT.5.11-MAT.5.12]]) und der übrige Inhalt der Rede (Antithesen, Unservater, Haus auf dem Fels) stehen in den Kapitelbildern."
      }
    ],
    [
      {
        "s": "B",
        "ref": "MAT.27.50",
        "de": "Jesus schreit noch einmal laut und gibt den Geist auf."
      },
      {
        "s": "B",
        "ref": "MAT.27.51",
        "de": "Die Erde bebt, die Felsen spalten sich."
      },
      {
        "s": "B",
        "ref": "MAT.27.54",
        "de": "Der Hauptmann und die mit ihm Jesus bewachen, fürchten sich sehr und sagen: Wahrhaftig, dieser war Gottes Sohn."
      },
      {
        "s": "R",
        "de": "Weggelassen: die zwei Mitgekreuzigten ([[MAT.27.38]]), die Inschrift ([[MAT.27.37]]) und der Tempelvorhang ([[MAT.27.51]]), der in der Stadt reisst."
      },
      {
        "s": "I",
        "de": "Knien und erhobene Hand: Bildgestaltung für Furcht und Bekenntnis."
      }
    ],
    [
      {
        "s": "B",
        "ref": "MAT.28.16",
        "de": "Die elf Jünger gehen nach Galiläa auf den Berg, wohin Jesus sie bestellt hat."
      },
      {
        "s": "B",
        "ref": "MAT.28.17",
        "de": "Als sie ihn sehen, fallen sie nieder; einige aber zweifeln."
      },
      {
        "s": "B",
        "ref": "MAT.28.19-MAT.28.20",
        "de": "Geht hin und macht alle Völker zu Jüngern … ich bin bei euch alle Tage."
      },
      {
        "s": "R",
        "de": "Fünf oder sechs Jünger stehen für die Elf; das leere Grab ([[MAT.28.1-MAT.28.10]]) steht in den Kapitelbildern."
      },
      {
        "s": "I",
        "de": "Ausgestreckter Arm in die Weite: Bildgestaltung für die Sendung zu allen Völkern."
      }
