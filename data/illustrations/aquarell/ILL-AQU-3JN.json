  "evidence": [
    [
      {
        "s": "B",
        "ref": "3JN.1.5",
        "de": "Du handelst treu an dem, was du an den Geschwistern tust, und das an Fremden."
      },
      {
        "s": "B",
        "ref": "3JN.1.6",
        "de": "Du tust gut, wenn du sie für die Weiterreise ausrüstest, wie es Gottes würdig ist."
      },
      {
        "s": "B",
        "ref": "3JN.1.7",
        "de": "Für den Namen sind sie ausgezogen."
      },
      {
        "s": "R",
        "de": "Brot und Wasserschlauch als Ausrüstung; Haus, Kleidung und die Zahl von drei Reisenden sind Ausgestaltung."
      }
    ],
    [
      {
        "s": "B",
        "ref": "3JN.1.9",
        "de": "Ich habe der Gemeinde etwas geschrieben; aber Diotrephes, der unter ihnen der Erste sein will, nimmt uns nicht auf."
      },
      {
        "s": "B",
        "ref": "3JN.1.10",
        "de": "Er selbst nimmt die Geschwister nicht auf, hindert die, die es wollen, und stösst sie aus der Gemeinde."
      },
      {
        "s": "I",
        "de": "Der Brief in der Hand des Reisenden steht für das Schreiben des Ältesten ([[3JN.1.9]]); dass die Reisenden es überbringen, sagt der Text nicht."
      },
      {
        "s": "R",
        "de": "Die Haustür als Ort von Aufnahme und Abweisung; dass Diotrephes auch Aufnahmebereite ausstösst ([[3JN.1.10]]), ist nicht gemalt."
      }
    ],
    [
      {
        "s": "B",
        "ref": "3JN.1.11",
        "de": "Ahme nicht das Böse nach, sondern das Gute; wer Gutes tut, ist aus Gott; wer Böses tut, hat Gott nicht gesehen."
      },
      {
        "s": "B",
        "ref": "3JN.1.12",
        "de": "Demetrius hat ein gutes Zeugnis von allen und von der Wahrheit selbst; auch wir geben Zeugnis."
      }
    ]
  ],
