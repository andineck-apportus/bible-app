  "actions_de": [
    "Jona ist zornig, weil Gott gnädig ist, und wünscht sich den Tod.",
    "Gott lässt einen Rizinus wachsen und durch einen Wurm verdorren; die Sonne sticht Jona.",
    "Gott fragt Jona, ob er nicht Mitleid haben soll mit Ninive, der grossen Stadt."
  ],
  "captions_de": [
    "Zorn: Jona ist zornig (zorniges Gesicht) und betet zu Gott: Du bist gnädig (Herz in Händen) – lass mich sterben (Totenkopf).",
    "Sonne → Jona: Unter der Hütte sitzt Jona; ein Wurm lässt die Staude verdorren, die Sonne sticht ihn (Pfeil).",
    "Gottes Frage: Bei der verdorrten Staude fragt Gott Jona: Sollte ich nicht Mitleid haben mit Ninive? (Herz, Stadt, Fragezeichen)"
  ],
  "interpretation_note_de": "Je ein Feld zu Jonas Zorn, der Staude und Gottes Frage; das Buch endet offen.",
