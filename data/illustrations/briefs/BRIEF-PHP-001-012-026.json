              "b": {
                "de": "Sie wollen mir in den Fesseln Bedrängnis bereiten.",
                "gsw": "Si wänd mir i de Fessle Not mache."
              },
              "icons": [
                "FIG-ZEICHEN-STREIT"
              ]
            },
            {
              "a": {
                "de": "Andere verkündigen ihn aus Liebe",
                "gsw": "Anderi verchünded en us Liebi"
