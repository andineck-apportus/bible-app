              "de": "1. Knecht: fünf Talente",
              "gsw": "1. Chnächt: föif Talänt"
            },
            "icons": [
              "FIG-OBJ-TALENT"
            ]
          },
          {
            "a": {
              "de": "Er arbeitete damit und gewann weitere fünf.",
              "gsw": "Er hät damit gschaffet und föif anderi gwunne."
